# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=ibarra_app
TYPEORM_SYNC=false

# Auth
JWT_SECRET=change_me_to_a_long_random_secret

# Initial admin / setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_8_chars

# Public backend URL used in password-reset emails
API_URL=http://localhost:3000

# Desktop app deep-link scheme
APP_SCHEME=ibarrayasoc

# Google OAuth, Gmail and Calendar
GOOGLE_CLIENT_ID=change_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# SMTP used by password-reset/system emails
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=change_me
DEFAULT_EMAIL_FROM="Ibarra & Asoc. <user@example.com>"

# AWS S3 document storage
AWS_S3_REGION=us-east-1
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=change_me_bucket
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_SESSION_TOKEN=

# Geo-IP lookup for login history
GEOIP_PROVIDER=ipapi
GEOIP_API_KEY=
GEOIP_TIMEOUT_MS=1500
GEOIP_TTL_MIN=10080
